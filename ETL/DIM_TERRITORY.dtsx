              DTS:EvaluateAsExpression="True"
              DTS:Expression="&quot;&#xA;IF NOT EXISTS(SELECT 1 FROM [SALE].[DIM_TERRITORY] WHERE Id=&quot;+(DT_WSTR, 100)@[$Project::NullNumber]+&quot;)&#xA; BEGIN&#xA;&#x9;SET IDENTITY_INSERT [SALE].[DIM_TERRITORY] ON&#xA;&#xA; INSERT INTO [SALE].[DIM_TERRITORY] &#xA;&#x9;&#x9;&#x9;([Id]&#xA;           ,[BKTerritoryID]&#xA;           ,[TerritoryName]&#xA;           ,[CountryRegionCode]&#xA;           ,[TerritoryGroup]&#xA;           ,[SalesYTD]&#xA;           ,[SalesLastYear]&#xA;           ,[CostYTD]&#xA;           ,[CostLastYear]&#xA;           ,[SysInsertDate]&#xA;           ,[SysUpdateDate]&#xA;           ,[SysDeleteDate]&#xA;           ,[SysHashValue]&#xA;           ,[SysDataSource]&#xA;           ,[SysDataSourceID])&#xA;     VALUES&#xA;           (&quot;+(DT_WSTR, 100)@[$Project::NullNumber]+&quot;&#xA;           ,&quot;+(DT_WSTR, 100)@[$Project::NullNumber]+&quot;&#xA;           ,N'&quot;+@[$Project::NullString]+&quot;'&#xA;           ,N'&quot;+@[$Project::NullString]+&quot;'&#xA;           ,N'&quot;+@[$Project::NullString]+&quot;'&#xA;           ,&quot;+(DT_WSTR, 100)@[$Project::NullNumber]+&quot;&#xA;           ,&quot;+(DT_WSTR, 100)@[$Project::NullNumber]+&quot;&#xA;           ,&quot;+(DT_WSTR, 100)@[$Project::NullNumber]+&quot;&#xA;           ,&quot;+(DT_WSTR, 100)@[$Project::NullNumber]+&quot;&#xA;           ,'1900-01-01'&#xA;           ,NULL&#xA;           ,NULL&#xA;           ,N'&quot;+@[$Project::NullString]+&quot;'&#xA;           ,N'&quot;+@[$Project::NullString]+&quot;'&#xA;           ,N'&quot;+@[$Project::NullString]+&quot;')&#xA;&#xA;&#x9;SET IDENTITY_INSERT [SALE].[DIM_TERRITORY] OFF&#xA;END&#xA;&quot;"
              DTS:IncludeInDebugDump="2345"
              DTS:Namespace="User"
              DTS:ObjectName="sqlStatement_UNKNOWN">
              <DTS:VariableValue
                DTS:DataType="8">
IF NOT EXISTS(SELECT 1 FROM [SALE].[DIM_TERRITORY] WHERE Id=-1)
 BEGIN
	SET IDENTITY_INSERT [SALE].[DIM_TERRITORY] ON

 INSERT INTO [SALE].[DIM_TERRITORY] 
			([Id]
           ,[BKTerritoryID]
           ,[TerritoryName]
           ,[CountryRegionCode]
           ,[TerritoryGroup]
           ,[SalesYTD]
           ,[SalesLastYear]
           ,[CostYTD]
           ,[CostLastYear]
           ,[SysInsertDate]
           ,[SysUpdateDate]
           ,[SysDeleteDate]
           ,[SysHashValue]
           ,[SysDataSource]
           ,[SysDataSourceID])
     VALUES
           (-1
           ,-1
           ,N'Unknown'
           ,N'Unknown'
           ,N'Unknown'
           ,-1
           ,-1
           ,-1
           ,-1
           ,'1900-01-01'
           ,NULL
           ,NULL
           ,N'Unknown'
           ,N'Unknown'
           ,N'Unknown')

	SET IDENTITY_INSERT [SALE].[DIM_TERRITORY] OFF
END
</DTS:VariableValue>
            </DTS:Variable>
