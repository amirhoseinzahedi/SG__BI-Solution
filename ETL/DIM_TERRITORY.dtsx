              DTS:ObjectName="varExtractTerritory">
              <DTS:VariableValue
                DTS:DataType="8">SELECT
    TerritoryID,
    Name,
    CountryRegionCode,
    [Group],
    SalesYTD,
    SalesLastYear,
    CostYTD,
    CostLastYear
FROM [Sales].[SalesTerritory]
 WHERE ModifiedDate&gt;=DATEADD(DAY, -1, GETDATE())</DTS:VariableValue>
